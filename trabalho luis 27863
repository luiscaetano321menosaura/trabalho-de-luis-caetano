#include <iostream>
#include <string>

using namespace std;

int main() {
    const int MAX_CONTAS = 5;
    
    int numeroConta[MAX_CONTAS];
    string nomeCliente[MAX_CONTAS];
    string cpf[MAX_CONTAS];
    int tipoConta[MAX_CONTAS]; 
    double saldo[MAX_CONTAS];
    bool contaAtiva[MAX_CONTAS]; 
    
    string email[MAX_CONTAS];

    int totalContas = 0;
    int opcao = 0;

    do {
        cout << "\n=================================\n";
        cout << "            BANCO INF101         \n";
        cout << "=================================\n";
        cout << "Contas registadas: " << totalContas << "/" << MAX_CONTAS << "\n";
        cout << "1 - Cadastrar conta\n";
        cout << "2 - Consultar conta\n";
        cout << "3 - Verificar saldo\n";
        cout << "4 - Alterar tipo da conta\n";
        cout << "5 - Ativar/Desativar conta\n";
        cout << "6 - Sair\n";
        cout << "Escolha uma opcao: ";
        cin >> opcao;

        switch(opcao) {
            case 1: { 
                if (totalContas >= MAX_CONTAS) {
                    cout << "Erro: Limite maximo de contas atingido!\n";
                } else {
                    cout << "\n--- Cadastrar Conta ---\n";
                    
                    do {
                        cout << "Numero da conta (maior que zero): ";
                        cin >> numeroConta[totalContas];
                    } while(numeroConta[totalContas] <= 0); 

                    cout << "Nome do titular: ";
                    cin.ignore(); 
                    getline(cin, nomeCliente[totalContas]);

                    cout << "CPF: ";
                    getline(cin, cpf[totalContas]);
                    
                    cout << "Email: ";
                    getline(cin, email[totalContas]);

                    do {
                        cout << "Tipo da conta (1 = Corrente; 2 = Poupanca): ";
                        cin >> tipoConta[totalContas];
                    } while(tipoConta[totalContas] != 1 && tipoConta[totalContas] != 2); 

                    do {
                        cout << "Saldo inicial (nao pode ser negativo): ";
                        cin >> saldo[totalContas];
                    } while(saldo[totalContas] < 0.0); 

                    contaAtiva[totalContas] = true;
                    
                    totalContas++; 
                    cout << "Conta cadastrada com sucesso!\n";
                }
                break;
            }

            case 2: { 
                if (totalContas == 0) {
                    cout << "Erro: Nenhuma conta cadastrada.\n";
                } else {
                    int numBusca, indice = -1;
                    cout << "Introduza o numero da conta a consultar: ";
                    cin >> numBusca;

                    for (int i = 0; i < totalContas; i++) {
                        if (numeroConta[i] == numBusca) {
                            indice = i;
                            break;
                        }
                    }

                    if (indice == -1) {
                        cout << "Erro: Conta nao encontrada.\n";
                    } else {
                        cout << "\n--- Dados da Conta ---\n";
                        cout << "Numero: " << numeroConta[indice] << "\n";
                        cout << "Titular: " << nomeCliente[indice] << "\n";
                        cout << "CPF: " << cpf[indice] << "\n";
                        cout << "Email: " << email[indice] << "\n";
                        cout << "Tipo: " << (tipoConta[indice] == 1 ? "Corrente" : "Poupanca") << "\n";
                        cout << "Estado: " << (contaAtiva[indice] ? "Ativa" : "Desativada") << "\n";
                    }
                }
                break;
            }

            case 3: { 
                if (totalContas == 0) {
                    cout << "Erro: Nenhuma conta cadastrada.\n";
                } else {
                    int numBusca, indice = -1;
                    cout << "Introduza o numero da conta para ver o saldo: ";
                    cin >> numBusca;

                    for (int i = 0; i < totalContas; i++) {
                        if (numeroConta[i] == numBusca) {
                            indice = i;
                            break;
                        }
                    }

                    if (indice == -1) {
                        cout << "Erro: Conta nao encontrada.\n";
                    } else if (!contaAtiva[indice]) {
                        cout << "Erro: Operacao indisponivel. A conta esta desativada.\n";
                    } else {
                        cout << "\nSaldo atual da conta " << numeroConta[indice] << ": " << saldo[indice] << "\n";
                    }
                }
                break;
            }

            case 4: { 
                if (totalContas == 0) {
                    cout << "Erro: Nenhuma conta cadastrada.\n";
                } else {
                    int numBusca, indice = -1;
                    cout << "Introduza o numero da conta para alterar o tipo: ";
                    cin >> numBusca;

                    for (int i = 0; i < totalContas; i++) {
                        if (numeroConta[i] == numBusca) {
                            indice = i;
                            break;
                        }
                    }

                    if (indice == -1) {
                        cout << "Erro: Conta nao encontrada.\n";
                    } else if (!contaAtiva[indice]) {
                        cout << "Erro: Operacao indisponivel. A conta esta desativada.\n";
                    } else {
                        tipoConta[indice] = (tipoConta[indice] == 1) ? 2 : 1;
                        cout << "Tipo de conta alterado com sucesso para: " << (tipoConta[indice] == 1 ? "Corrente" : "Poupanca") << "\n";
                    }
                }
                break;
            }

            case 5: { 
                if (totalContas == 0) {
                    cout << "Erro: Nenhuma conta cadastrada.\n";
                } else {
                    int numBusca, indice = -1;
                    cout << "Introduza o numero da conta para alterar o seu estado: ";
                    cin >> numBusca;

                    for (int i = 0; i < totalContas; i++) {
                        if (numeroConta[i] == numBusca) {
                            indice = i;
                            break;
                        }
                    }

                    if (indice == -1) {
                        cout << "Erro: Conta nao encontrada.\n";
                    } else {
                        contaAtiva[indice] = !contaAtiva[indice];
                        cout << "A conta " << numeroConta[indice] << " encontra-se agora " << (contaAtiva[indice] ? "Ativa" : "Desativada") << ".\n";
                    }
                }
                break;
            }

            case 6: 
                cout << "A encerrar o sistema...\n";
                break;

            default:
                cout << "Opcao invalida! Tente novamente.\n";
        }
    } while(opcao != 6); 

    return 0;
}
